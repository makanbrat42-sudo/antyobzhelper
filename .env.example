# ─── AntyObzhelp: переменные окружения ───
# Скопируйте в .env (локально) или задайте в настройках хостинга. Никогда не коммитьте .env.

# Публичный адрес сайта без завершающего слеша (используется в redirect_uri VK ID и ссылках бота)
APP_URL=http://localhost:3000

# PostgreSQL. Для Supabase: DATABASE_URL — пулер (порт 6543, ?pgbouncer=true), DIRECT_URL — прямое подключение (порт 5432)
DATABASE_URL=postgresql://antyobzhelp:antyobzhelp@localhost:5433/antyobzhelp
DIRECT_URL=

# Секрет для подписи cookie (минимум 32 символа). Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Одноразовый токен первоначальной настройки администратора (страница /setup).
# Работает, только пока в системе нет ни одного активного администратора.
SETUP_TOKEN=

# ─── VK ID (вход сотрудников и подтверждение VK кандидатами) ───
# Приложение создаётся на https://id.vk.com → «Мои приложения». Тип: Web.
# Доверенный Redirect URI: ${APP_URL}/api/auth/vk/callback
VK_ID_CLIENT_ID=
VK_ID_BASE_URL=https://id.vk.ru

# ─── VK-бот сообщества (Callback API) ───
VK_GROUP_ID=
# Ключ доступа сообщества с правами: сообщения сообщества
VK_GROUP_TOKEN=
# Строка подтверждения, которую выдаёт VK в настройках Callback API
VK_CALLBACK_CONFIRMATION=
# Секретный ключ Callback API (поле «Секретный ключ»)
VK_CALLBACK_SECRET=
VK_API_BASE_URL=https://api.vk.ru/method
VK_API_VERSION=5.199

# ─── Google Forms ───
# Общий секрет HMAC между Google Apps Script и сервером
GOOGLE_FORMS_SECRET=

# ─── Служебное ───
# Секрет для /api/cron/maintenance (Vercel Cron передаёт его в заголовке Authorization: Bearer)
CRON_SECRET=
